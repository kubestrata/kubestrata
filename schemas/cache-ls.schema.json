{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kubestrata/kubestrata/blob/main/schemas/cache-ls.schema.json",
  "title": "kubestrata cache ls --format json",
  "description": "Cached snapshots.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Version of this document. Consumers refuse a higher value than they support."
    },
    "dir": {
      "type": "string",
      "description": "Cache directory."
    },
    "snapshots": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "cluster_id": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "distro": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time"
          },
          "stamp": {
            "type": "string",
            "description": "File name stamp that diff --from/--to take."
          },
          "path": {
            "type": "string"
          },
          "resources": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "cluster_id",
          "collected_at",
          "context",
          "errors",
          "path",
          "resources",
          "stamp"
        ]
      },
      "description": "Newest first."
    }
  },
  "required": [
    "dir",
    "schema_version",
    "snapshots"
  ]
}
